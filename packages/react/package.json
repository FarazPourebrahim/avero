{
  "name": "@avero/react",
  "version": "1.0.0",
  "type": "module",
  "description": "Bidirectional React components for Persian (RTL) and English (LTR), built on Radix UI.",
  "sideEffects": false,
  "exports": {
    ".": {
      "@avero/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "@avero/source": "./src/components/*/index.ts",
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json && node scripts/verify-build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test-watch": "vitest",
    "coverage": "vitest run --coverage",
    "size": "size-limit"
  },
  "peerDependencies": {
    "lucide-react": ">=0.400.0",
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "dependencies": {
    "@avero/tokens": "workspace:^",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "radix-ui": "^1.6.7",
    "tailwind-merge": "^3.6.0",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@avero/config": "workspace:^",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "axe-core": "^4.13.0",
    "jsdom": "^28.1.0",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "size-limit": "^12.1.0",
    "storybook": "^10.6.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0",
    "zod": "^4.6.2"
  },
  "peerDependenciesMeta": {
    "lucide-react": {
      "optional": true
    }
  },
  "license": "MIT",
  "author": "Faraz Pourebrahim",
  "homepage": "https://github.com/FarazPourebrahim/avero",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FarazPourebrahim/avero.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/FarazPourebrahim/avero/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
