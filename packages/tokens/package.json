{
  "name": "@avero/tokens",
  "version": "1.0.0",
  "type": "module",
  "description": "Avero design tokens: Tailwind CSS v4 theme, base styles, utilities and token data.",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./theme.css": "./src/theme.css",
    "./base.css": "./src/base.css",
    "./utilities.css": "./src/utilities.css",
    "./rich-content.css": "./src/rich-content.css",
    "./tokens.json": "./src/generated/tokens.json",
    ".": {
      "types": "./src/generated/tokens.d.ts",
      "import": "./src/generated/tokens.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "LICENSE"
  ],
  "scripts": {
    "generate": "node scripts/generate-token-data.mjs",
    "test": "node scripts/generate-token-data.mjs --check && node scripts/check-z-order.mjs",
    "contrast": "node scripts/contrast-report.mjs"
  },
  "peerDependencies": {
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "lightningcss": "1.32.0",
    "tailwindcss": "^4.3.3"
  },
  "license": "MIT",
  "author": "Faraz Pourebrahim",
  "homepage": "https://github.com/FarazPourebrahim/avero",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FarazPourebrahim/avero.git",
    "directory": "packages/tokens"
  },
  "bugs": {
    "url": "https://github.com/FarazPourebrahim/avero/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
