{
  "name": "@averoui/editor",
  "version": "2.0.0",
  "type": "module",
  "description": "Tiptap rich-text editor sharing Avero's prose styles.",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@averoui/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json && node scripts/verify-build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test-watch": "vitest",
    "coverage": "vitest run --coverage",
    "size": "size-limit"
  },
  "peerDependencies": {
    "@tiptap/extension-image": ">=3.0.0",
    "@tiptap/extension-table": ">=3.0.0",
    "@tiptap/extensions": ">=3.0.0",
    "@tiptap/pm": ">=3.0.0",
    "@tiptap/react": ">=3.0.0",
    "@tiptap/starter-kit": ">=3.0.0",
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "dependencies": {
    "@averoui/react": "workspace:^",
    "@averoui/tokens": "workspace:^",
    "radix-ui": "^1.6.7"
  },
  "devDependencies": {
    "@averoui/config": "workspace:^",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/html": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "axe-core": "^4.13.0",
    "jsdom": "^28.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "size-limit": "^12.1.0",
    "storybook": "^10.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "license": "MIT",
  "author": "Faraz Pourebrahim",
  "homepage": "https://github.com/FarazPourebrahim/avero",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FarazPourebrahim/avero.git",
    "directory": "packages/editor"
  },
  "bugs": {
    "url": "https://github.com/FarazPourebrahim/avero/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
